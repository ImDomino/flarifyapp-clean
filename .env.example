# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Privy Authentication
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Polymarket V2 Builder Attribution (Exchange order signing)
# Получить на https://polymarket.com/settings?tab=builder
# В V2 Exchange атрибуция билдера — это bytes32, вшитый в подписанный ордер.
# Если не задано, ордера размещаются без атрибуции (и без fee share).
NEXT_PUBLIC_POLYMARKET_BUILDER_ID=

# Polymarket Relayer HMAC credentials (Safe deployment / approvals / wraps)
# Релейер — отдельный сервис, он всё ещё использует HMAC-auth.
# Подписи считаются на сервере в /api/polymarket/sign, ключи не попадают в браузер.
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=

# Polygon RPC (optional, falls back to publicnode)
NEXT_PUBLIC_POLYGON_RPC_URL=

# CLOB host (optional). Default: https://clob.polymarket.com (prod, V2 after Apr 22 cutover).
# Set to https://clob-v2.polymarket.com to hit the V2 preprod endpoint before cutover.
NEXT_PUBLIC_CLOB_HOST=

# ВАЖНО:
# - User API credentials (L1/L2) создаются автоматически на клиенте
# - Хранятся в localStorage браузера
# - НЕ нужны в .env!
