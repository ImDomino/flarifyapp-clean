# Polymarket Builder Configuration

# === URL Attribution (работает сейчас) ===
# Ваш уникальный ID для отслеживания кликов
# Можно использовать любое название (например, название вашего проекта)
NEXT_PUBLIC_POLYMARKET_BUILDER_ID=FLARIFYAPP

# === API Keys (для production, когда добавите wallet) ===
# Получить на: https://polymarket.com/settings?tab=builder
# Нужны для реального размещения ордеров через CLOB

# POLYMARKET_API_KEY=your_api_key_here
# POLYMARKET_API_SECRET=your_api_secret_here
# POLYMARKET_API_PASSPHRASE=your_api_passphrase_here

# Note: 
# - Builder ID используется для URL tracking (клики по ссылкам)
# - API Keys нужны только для реального размещения ордеров
# - Сейчас работает demo режим без API keys
